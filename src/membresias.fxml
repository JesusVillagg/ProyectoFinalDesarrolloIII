<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="533.0" prefWidth="686.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MembresiasController">
    <children>
        <TableView fx:id="tablaClientes" layoutX="57.0" layoutY="281.0" onMouseClicked="#seleccionarCliente" prefHeight="200.0" prefWidth="582.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="69.6" text="ID Cliente" />
                <TableColumn fx:id="colNombre" prefWidth="126.4" text="Nombre Cliente" />
                <TableColumn fx:id="colDireccion" prefWidth="180.0" text="Dirección" />
                <TableColumn fx:id="colEmail" prefWidth="200.0" text="Email" />
            </columns>
        </TableView>

        <Label layoutX="107.0" layoutY="163.0" text="Dirección">
         <font>
            <Font size="15.0" />
         </font></Label>
        <Label layoutX="106.0" layoutY="121.0" text="Nombre Cliente">
         <font>
            <Font size="15.0" />
         </font></Label>

        <TextField fx:id="txtNombre" layoutX="234.0" layoutY="119.0" prefWidth="200.0" />
        <TextField fx:id="txtDireccion" layoutX="234.0" layoutY="161.0" prefWidth="200.0" />

        <Label layoutX="107.0" layoutY="212.0" text="Email">
         <font>
            <Font size="15.0" />
         </font></Label>
        <TextField fx:id="txtEmail" layoutX="234.0" layoutY="210.0" prefWidth="200.0" />

        <Button layoutX="487.0" layoutY="75.0" mnemonicParsing="false" onAction="#agregarCliente" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #ACFFCB;" text="Agregar" />
        <Button layoutX="487.0" layoutY="122.0" mnemonicParsing="false" onAction="#modificarCliente" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #A4DFFF;" text="Modificar" />
        <Button layoutX="487.0" layoutY="174.0" mnemonicParsing="false" onAction="#eliminarCliente" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #FFA9A5;" text="Eliminar" />
        <Button layoutX="487.0" layoutY="223.0" mnemonicParsing="false" onAction="#limpiarFormulario" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #FFF299;" text="Limpiar" />

        <Label layoutX="247.0" layoutY="37.0" text="Gestión de Membresías ">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
    </children>
</AnchorPane>
