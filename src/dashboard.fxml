<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="533.0" prefWidth="686.0" style="-fx-background-color: #f4f4f4;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="DashboardController">
    <children>
        <Label layoutX="52.0" layoutY="44.0" text="Bienvenido Administrador" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="24.0" />
            </font>
        </Label>

        <!-- Tarjeta de Productos -->
        <Pane layoutX="108.0" layoutY="134.0" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <children>
                <Label layoutX="47.0" layoutY="25.0" text="Productos Totales" textFill="#7f8c8d">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="lblTotalProductos" alignment="CENTER" layoutX="12.0" layoutY="55.0" prefHeight="53.0" prefWidth="176.0" text="0" textFill="#27ae60">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </children>
        </Pane>

        <!-- Tarjeta de Clientes -->
        <Pane layoutX="378.0" layoutY="134.0" prefHeight="150.0" prefWidth="200.0" style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 5);">
            <children>
                <Label layoutX="52.0" layoutY="25.0" text="Clientes Activos" textFill="#7f8c8d">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label fx:id="lblTotalClientes" alignment="CENTER" layoutX="12.0" layoutY="55.0" prefHeight="53.0" prefWidth="176.0" text="0" textFill="#2980b9">
                    <font>
                        <Font name="System Bold" size="36.0" />
                    </font>
                </Label>
            </children>
        </Pane>

        <!-- Logo o Decoración -->
        <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="243.0" layoutY="330.0" pickOnBounds="true" preserveRatio="true">
            <!-- Si tienes el logo, asegúrate de que la ruta sea correcta, si no, borra el ImageView -->
            <!-- <image> <Image url="@imagenes/logo.png" /> </image> -->
        </ImageView>
    </children>
</AnchorPane>