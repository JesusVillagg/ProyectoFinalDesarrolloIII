<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="533.0" prefWidth="686.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CatalogoAdminController">
   <children>
      <TableView fx:id="tablaProductos" layoutX="57.0" layoutY="298.0" onMouseClicked="#seleccionarProducto" prefHeight="200.0" prefWidth="573.0">
         <columns>
            <TableColumn fx:id="colId" prefWidth="82.4" text="ID Producto" />
            <TableColumn fx:id="colNombre" prefWidth="121.0" text="Nombre" />
            <TableColumn fx:id="colMarca" prefWidth="99.0" text="Marca" />
            <TableColumn fx:id="colPrecio" prefWidth="85.0" text="Precio" />
            <TableColumn fx:id="colStock" prefWidth="84.0" text="Stock" />
            <TableColumn fx:id="colProveedor" prefWidth="99.0" text="ID Proveedor" />
         </columns>
      </TableView>

      <Label layoutX="118.0" layoutY="149.0" text="Precio Venta" />
      <Label layoutX="120.0" layoutY="114.0" text="Marca" />
      <Label layoutX="118.0" layoutY="80.0" text="Nombre Perfume" />

      <TextField fx:id="txtNombre" layoutX="234.0" layoutY="76.0" prefWidth="200.0" />
      <TextField fx:id="txtMarca" layoutX="234.0" layoutY="110.0" prefWidth="200.0" />
      <TextField fx:id="txtPrecio" layoutX="234.0" layoutY="145.0" prefWidth="200.0" promptText="0.00" />

      <Label layoutX="122.0" layoutY="191.0" text="Stock" />
      <TextField fx:id="txtStock" layoutX="234.0" layoutY="187.0" prefWidth="200.0" promptText="0" />

      <Label layoutX="122.0" layoutY="228.0" text="ID Proveedor" />
      <ComboBox fx:id="comboProveedor" layoutX="234.0" layoutY="224.0" prefHeight="26.0" prefWidth="200.0" promptText="Seleccione..." />

      <Button layoutX="487.0" layoutY="75.0" mnemonicParsing="false" onAction="#agregarProducto" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #ACFFCB;" text="Agregar" />
      <Button layoutX="487.0" layoutY="122.0" mnemonicParsing="false" onAction="#modificarProducto" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #A4DFFF;" text="Modificar" />
      <Button layoutX="487.0" layoutY="174.0" mnemonicParsing="false" onAction="#eliminarProducto" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #FFA9A5;" text="Eliminar" />
      <Button layoutX="487.0" layoutY="223.0" mnemonicParsing="false" onAction="#limpiarFormulario" prefHeight="26.0" prefWidth="85.0" style="-fx-background-color: #FFF299;" text="Limpiar" />

      <Label layoutX="323.0" layoutY="32.0" text="Gestión de Productos">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
   </children>
</AnchorPane>