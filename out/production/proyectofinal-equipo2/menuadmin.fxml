<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="MenuAdminController">
   <children>
      <VBox prefHeight="600.0" prefWidth="214.0" style="-fx-background-color: #5A7D77;" AnchorPane.bottomAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Pane prefHeight="136.0" prefWidth="214.0">
               <children>
                  <ImageView fitHeight="113.0" fitWidth="198.0" layoutX="8.0" layoutY="5.0" pickOnBounds="true" preserveRatio="true">
                     <image>

                        <Image url="@imagenes/logo.png" />
                     </image>
                  </ImageView>
               </children>
            </Pane>

            <Button mnemonicParsing="false" onAction="#irAInicio" prefHeight="50.0" prefWidth="214.0" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 30;" text="Inicio" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="30.0" top="30.0" />
               </VBox.margin>
            </Button>

            <Button mnemonicParsing="false" onAction="#irACatalogoAdmin" prefHeight="50.0" prefWidth="214.0" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 30;" text="Productos" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="30.0" />
               </VBox.margin>
            </Button>

            <Button mnemonicParsing="false" onAction="#irAMembresias" prefHeight="50.0" prefWidth="214.0" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 30;" text="Clientes" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="30.0" />
               </VBox.margin>
            </Button>

            <Button mnemonicParsing="false" onAction="#irAGestionProveedores" prefHeight="50.0" prefWidth="214.0" style="-fx-background-color: transparent; -fx-alignment: CENTER_LEFT; -fx-padding: 0 0 0 30;" text="Proveedores" textFill="WHITE">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Button>

            <Pane prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />

            <Button mnemonicParsing="false" onAction="#regresarInicio" prefHeight="70.0" prefWidth="214.0" style="-fx-background-color: #FFA9A5;" text="Cerrar Sesión" textFill="#363636">
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </VBox>


      <Pane fx:id="panelContenido" layoutX="214.0" prefHeight="600.0" prefWidth="686.0" style="-fx-background-color: #f4f4f4;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="214.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
   </children>
</AnchorPane>
